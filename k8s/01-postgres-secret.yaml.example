# Secret contenant les identifiants de la base de données.
# NE PAS committer de vraies valeurs : copier ce fichier en 01-postgres-secret.yaml
# et y placer des valeurs encodées en base64 (echo -n 'valeur' | base64).
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: techcorp-orders
type: Opaque
data:
  POSTGRES_USER: dGVjaGNvcnA=       # techcorp (exemple, a remplacer)
  POSTGRES_PASSWORD: dGVjaGNvcnA=   # techcorp (exemple, a remplacer)
  POSTGRES_DB: dGVjaGNvcnBfb3JkZXJz # techcorp_orders
